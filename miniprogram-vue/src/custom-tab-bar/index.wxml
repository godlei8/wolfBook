<view class="tabbar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab {{selected === index ? 'tab--on' : ''}} {{item.center ? 'tab--center' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view wx:if="{{item.center}}" class="tab-mid">
      <image class="tab-mid-icon" src="/static/tabbar/judge-center.png" />
    </view>
    <image wx:else class="tab-icon" src="{{selected === index ? item.activeIcon : item.icon}}" />
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>

# Domain / gateway
CORS_ALLOWED_ORIGIN_PATTERNS=https://wolfbook.godlei8.top

# MySQL
MYSQL_DATABASE=wolfbook
MYSQL_USERNAME=wolfbook
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me-root

# Redis
REDIS_PASSWORD=
REDIS_DATABASE=0

# Community search
COMMUNITY_MEILI_ENABLED=true
COMMUNITY_MEILI_BASE_URL=http://meilisearch:7700
COMMUNITY_MEILI_MASTER_KEY=replace-me-meili
COMMUNITY_MEILI_INDEX=community_posts

# PostgreSQL / pgvector
PGVECTOR_DATABASE=wolfbook_ai
PGVECTOR_USERNAME=wolfbook_ai
PGVECTOR_PASSWORD=replace-me-pg
ASSISTANT_PGVECTOR_TABLE=assistant_vector_store

# Admin bootstrap
ADMIN_INIT_PASSWORD=replace-me-admin

# AI / MiniMax + Ollama
ASSISTANT_EMBEDDING_PROVIDER=ollama
MINIMAX_API_KEY=replace-me-minimax
MINIMAX_BASE_URL=https://api.minimax.chat
MINIMAX_CHAT_MODEL=MiniMax-M2.7
MINIMAX_EMBEDDING_MODEL=embo-01
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
ASSISTANT_ENABLED=true
ASSISTANT_WEB_SEARCH_ENABLED=true
ASSISTANT_PGVECTOR_ENABLED=true

# COS
COS_SECRET_ID=replace-me-cos-id
COS_SECRET_KEY=replace-me-cos-key
COS_BUCKET=godlei-1311686380
COS_REGION=ap-chengdu
COS_PUBLIC_BASE_URL=https://cos.godlei8.top
COS_PREFIX=wolfbook

# WeChat mini program
WECHAT_MINI_APP_ID=replace-me-wechat-appid
WECHAT_MINI_APP_SECRET=replace-me-wechat-secret
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# Optional JVM tuning
JAVA_OPTS=-Xms512m -Xmx1024m
